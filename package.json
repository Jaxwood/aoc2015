{
  "name": "aoc2015",
  "version": "0.0.1",
  "description": "Advent of code 2015",
  "main": "index.js",
  "scripts": {
    "prebuild": "npm run lint",
    "build": "tsc",
    "pretest": "npm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\""
  },
  "author": "Jacob Lorenzen",
  "license": "MIT",
  "dependencies": {
    "fs-readfile-promise": "^3.0.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/fs-readfile-promise": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^26.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.6.3",
    "eslint": "^10.9.1",
    "@eslint/js": "^9.35.0",
    "typescript-eslint": "^8.70.0",
    "globals": "^17.12.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".test.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  }
